#!/bin/sh
set -eu
APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${JAVA_HOME:-}" ]; then JAVA_EXE="$JAVA_HOME/bin/java"; else JAVA_EXE=java; fi
if [ ! -f "$APP_DIR/gradle/wrapper/gradle-wrapper.jar" ]; then
  printf '%s\n' 'Missing gradle-wrapper.jar. Run Gradle 8.9: gradle wrapper --gradle-version 8.9' >&2
  exit 1
fi
exec "$JAVA_EXE" -classpath "$APP_DIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
