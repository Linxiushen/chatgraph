# Copy to chatgraph/.env. The application loads this file without shell execution.
# Existing shell environment values take precedence. Never commit real credentials.
CHATGRAPH_API_BASE_URL=https://api.deepseek.com
CHATGRAPH_API_KEY=
CHATGRAPH_MODEL=deepseek-v4-pro
CHATGRAPH_REASONING_EFFORT=max
CHATGRAPH_PORT=4317
# CHATGRAPH_DATA_DIR=/absolute/path/to/private-data
# Hosted mode requires an HTTPS reverse proxy and an owner password:
# CHATGRAPH_HOST=0.0.0.0
# CHATGRAPH_PUBLIC_ORIGIN=https://graph.example.com
# CHATGRAPH_AUTH_PASSWORD=replace-with-a-long-private-password
